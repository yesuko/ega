<div class="login">
  <img class="logo" src="<%= asset_path('/icon.svg') %>" alt="" width="64" height="64">
  <h1 class="center" style="font-size: 28px; margin-bottom: 6px">Join Ega</h1>
  <p class="center muted" style="margin: 0 auto 20px; max-width: 34ch">Split every income into pots, see what's safe to spend today, and build the habits that keep your money calm.</p>

  <% if error %><div class="flash error" role="alert"><%= error %></div><% end %>
  <form method="post" action="/signup" class="card">
    <div class="field">
      <label class="label" for="name">Your name</label>
      <input type="text" id="name" name="name" value="<%= form['name'] %>" maxlength="60" autocomplete="name" required autofocus>
    </div>
    <div class="field">
      <label class="label" for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= form['email'] %>" autocomplete="email" required>
      <p class="hint">You log in with it. We don't send you anything.</p>
    </div>
    <div class="row2">
      <div class="field">
        <label class="label" for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" maxlength="72" required>
      </div>
      <div class="field">
        <label class="label" for="confirm">Again</label>
        <input type="password" id="confirm" name="confirm" autocomplete="new-password" minlength="8" maxlength="72" required>
      </div>
    </div>
    <p class="hint" style="margin: -8px 0 16px">At least 8 characters. There's no password reset yet, so keep it somewhere safe.</p>
    <div class="hp" aria-hidden="true">
      <label for="website">Leave this empty</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
    </div>
    <button class="btn block" type="submit">Create account</button>
  </form>
  <p class="center small" style="margin-top: 14px">Have an account? <a href="/login">Log in</a></p>
</div>
