<% unless result %>
  <form method="post" action="/import">
    <%== erb :_error, layout: false, locals: { error: error } %>
    <p class="muted small" style="margin: 0 4px 14px">Copy a MoMo or bank alert from your messages and paste it here. You check everything before it's saved.</p>
    <div class="field">
      <textarea name="text" aria-label="SMS text" placeholder="Payment received for GHS 50.00 from …" required autofocus><%= text %></textarea>
    </div>
    <button class="btn block" type="submit">Read it</button>
    <p class="hint center">Works with MTN MoMo, Telecel Cash, AT Money and most bank alerts.</p>
  </form>
<% else %>
  <% direction = result[:direction] %>
  <div class="card">
    <div class="between">
      <div>
        <div class="muted small" style="font-weight: 600"><%= result.dig(:network, :name) || 'SMS' %> · <%= direction == :in ? 'money in' : direction == :out ? 'money out' : 'not sure which way' %></div>
        <div style="font-size: 30px; font-weight: 750" class="<%= direction == :in ? 'pos' : '' %>"><%= cedis(result[:amount]) %></div>
      </div>
      <span class="badge <%= direction == :out ? 'c-muted' : '' %>"><%== icon(direction == :out ? :arrow_up_right : :arrow_down_left) %></span>
    </div>
    <div class="rows small" style="margin-top: 8px">
      <% [['Who', result[:counterparty]], ['Reference', result[:reference] || result[:description]], ['Fee', result[:fee].positive? ? cedis(result[:fee]) : nil],
          ['Balance after', result[:balance] && cedis(result[:balance])], ['Date', result[:on] && long_date(result[:on])], ['Transaction ID', result[:ref_id]]].each do |label, value| %>
        <% next unless value %>
        <div class="row" style="padding: 8px 0"><span class="muted grow"><%= label %></span><span style="font-weight: 600; text-align: right"><%= value %></span></div>
      <% end %>
    </div>
  </div>

  <% if duplicate %>
    <div class="callout warn"><%== icon(:alert, size: 18) %><span>You already saved a transaction with this ID on <%= short_date(duplicate.occurred_on) %>. <a href="/transactions/<%= duplicate.id %>">Look at it</a> before saving it again.</span></div>
  <% end %>

  <div class="stack">
    <% if direction != :out %>
      <a class="btn block" href="<%= links[:income] %>"><%== icon(:arrow_down_left, size: 18) %>Record as money in</a>
    <% end %>
    <% if direction != :in %>
      <a class="btn block <%= 'ghost' if direction.nil? %>" href="<%= links[:spend] %>"><%== icon(:arrow_up_right, size: 18) %>Record as spending</a>
    <% end %>
    <a class="btn block ghost" href="<%= links[:move] %>"><%== icon(:arrow_left_right, size: 18) %>It was a move between my accounts</a>
    <% if links[:check] %>
      <a class="btn block ghost" href="<%= links[:check] %>"><%== icon(:scale, size: 18) %>Check <%= account&.name || 'the account' %> against <%= cedis(result[:balance], short: true) %></a>
    <% end %>
    <a class="btn block link" href="/import">Paste another</a>
  </div>
<% end %>
