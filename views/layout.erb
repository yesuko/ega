<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Ega">
  <title><%= [@title, 'Ega'].compact.uniq.join(' · ') %></title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="<%= asset_path('/icon.svg') %>" type="image/svg+xml">
  <link rel="apple-touch-icon" href="<%= asset_path('/apple-touch-icon.png') %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= asset_path('/style.css') %>">
  <script src="<%= asset_path('/app.js') %>" defer></script>
</head>
<body>
  <div class="app">
    <% if @title && current_user %>
      <header class="topbar">
        <% if @back %>
          <a class="icon-btn" href="<%= @back %>" aria-label="Back"><%== icon(:chevron_left) %></a>
        <% end %>
        <h1><%= @title %></h1>
      </header>
    <% end %>
    <main>
      <% if (flash = take_flash) %>
        <div class="flash <%= flash['kind'] %>" role="status"><%= flash['message'] %></div>
      <% end %>
      <%== yield %>
    </main>
  </div>

  <% if current_user %>
    <% path = request.path_info %>
    <nav class="tabs" aria-label="Main">
      <div class="tabs-inner">
        <a class="tab <%= 'on' if path == '/' %>" href="/"><%== icon(:house, size: 22) %>Home</a>
        <a class="tab <%= 'on' if path.start_with?('/buy') %>" href="/buy"><%== icon(:shopping_bag, size: 22) %>Buy List</a>
        <a class="tab tab-add" href="/add" data-sheet="add-sheet" aria-label="Add"><span class="plus"><%== icon(:plus, size: 24) %></span></a>
        <a class="tab <%= 'on' if path.start_with?('/invest') || path == '/learn' %>" href="/invest"><%== icon(:trending_up, size: 22) %>Invest</a>
        <a class="tab <%= 'on' if %w[/more /activity /review /settings /setup].include?(path) || path.start_with?('/transactions', '/inbox') %>" href="/more"><%== icon(:layout_grid, size: 22) %>More</a>
      </div>
    </nav>

    <dialog class="sheet" id="add-sheet" aria-label="Add">
      <div class="sheet-handle"></div>
      <h2>Add</h2>
      <%== erb :_actions, layout: false %>
    </dialog>
  <% end %>
</body>
</html>
