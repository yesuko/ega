<% amount, tone = txn_amount(txn) %>
<a class="row" href="<%= with_back("/transactions/#{txn.id}") %>">
  <span class="badge sm <%= txn.kind == 'income' ? '' : 'c-muted' %>"><%== icon(txn.icon, size: 17) %></span>
  <div class="grow">
    <div class="title"><%= txn_title(txn) %></div>
    <div class="sub"><%= txn_detail(txn) %></div>
  </div>
  <div class="num <%= tone %>"><%= amount %><% if defined?(show_date) && show_date %><small><%= short_date(txn.occurred_on) %></small><% end %></div>
</a>
