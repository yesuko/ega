<div class="login">
  <div class="logo"><%== icon(:sprout, size: 30) %></div>
  <h1 class="center" style="font-size: 26px">Money Plan</h1>
  <p class="center muted" style="margin-bottom: 24px">Every cedi gets a job.</p>
  <% if error %><div class="flash error" role="alert"><%= error %></div><% end %>
  <form method="post" action="/login" class="card">
    <div class="field">
      <label class="label" for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= email %>" autocomplete="username" required autofocus>
    </div>
    <div class="field">
      <label class="label" for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
    </div>
    <button class="btn block" type="submit">Log in</button>
  </form>
</div>
