# Postgres on the server, e.g. postgres://money_plan:secret@localhost:4044/money_plan
# For a quick local try, a file database works too: sqlite://db/development.sqlite3
DATABASE_URL=sqlite://db/development.sqlite3

# Signs the login cookie: at least 64 characters.
# Generate with: ruby -rsecurerandom -e "puts SecureRandom.hex(48)"
SESSION_SECRET=changeme

PORT=4600

# Set to production behind HTTPS, so the login cookie is only sent over HTTPS.
APP_ENV=development
